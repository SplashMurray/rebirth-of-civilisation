// Rebirth of Civilisation - Windows resources (version is filled in by CMake from project(VERSION ...))
#include <winver.h>
1 ICON "@REBIRTH_RES_DIR@/rebirth.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "Rebirth of Civilisation project"
      VALUE "FileDescription", "Rebirth of Civilisation"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "RebirthOfCivilisation"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "RebirthOfCivilisation.exe"
      VALUE "ProductName", "Rebirth of Civilisation"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x809, 1200
  END
END
